{
  "name": "ai-anpr-traffic-sentinel-mern",
  "version": "2.0.0",
  "description": "AI-Powered Intelligent Vehicle Identification & Traffic Violation Detection System Using ANPR (MERN + FastAPI)",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:ai": "cd ai-service && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "test:integration": "python tests/test_full_integration.py",
    "migrate:db": "python server/scripts/migrate_sqlite_to_mongo.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
