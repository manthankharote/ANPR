# Environment & Secrets (Never commit credentials)
.env
.env.*
*.env
!.env.example

# Dependencies
node_modules/
*/node_modules/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Caches & Compiled Bytecode
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/
*.egg-info/

# Build Artifacts
dist/
build/
client/dist/
client/build/

# Operating System & Logs
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
.system_generated/

# Storage: Ignore generated evidence, keep directory structure
storage/evidence/*
!storage/evidence/.gitkeep
legacy/violations/*
!legacy/violations/.gitkeep

# Storage: Ignore user uploads except the active sample video
storage/uploads/*
!storage/uploads/sample_traffic.mp4
!storage/uploads/.gitkeep

# Models & Databases: Exclude general large binaries, preserve designated project assets
*.pt
!ai-service/app/models/yolov8n.pt
*.db
!legacy/traffic_system.db
*.sqlite
*.sqlite3
